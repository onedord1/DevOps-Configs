# =============================================================================
#  .env.example  —  copy to ".env" and adjust, then:  source .env
# -----------------------------------------------------------------------------
#  Everything in this project is driven by these variables. Nothing about your
#  environment (IPs, users, keys, versions, CIDRs) is hard-coded in the roles.
#  KEEP YOUR REAL .env OUT OF GIT (already covered by .gitignore).
# =============================================================================

# ---- Node connectivity (SSH) -----------------------------------------------
export K8S_CONTROL_PLANE_IP="43.204.212.220"
export K8S_WORKER1_IP="43.204.109.185"
export K8S_WORKER2_IP="13.204.82.125"

export K8S_SSH_USER="ubuntu"                 # remote login user (must have sudo)
export K8S_SSH_PORT="22"
export K8S_SSH_KEY="~/Documents/lenovo.pem"           # path to the private key
# Set to "True" once known_hosts is populated, for a hardened run.
export ANSIBLE_HOST_KEY_CHECKING="False"

# ---- Cluster identity / versions -------------------------------------------
export K8S_CONTROL_PLANE_NAME="control-plane"
export K8S_MINOR_VERSION="1.36"              # apt repo channel (pkgs.k8s.io)
export CILIUM_VERSION="1.19.5"
export HELM_VERSION="v3.16.4"                # official get.helm.sh binary (SHA256-verified)
export HELM_CHART_NAMESPACE="kube-system"

# ---- Networking -------------------------------------------------------------
export K8S_POD_CIDR="192.168.0.0/16"
export K8S_SERVICE_CIDR="10.96.0.0/12"
# Advertise / node IP — the address kubeadm BINDS the API server to. Must be an
# IP on the node's NIC. Leave blank to auto-detect each node's primary IPv4
# (recommended on clouds where the public IP is NATed and not on the NIC).
export K8S_API_ADVERTISE_ADDRESS=""

# Stable, externally-reachable control-plane endpoint baked into the kubeconfig
# "server:" field and the API server certificate. Set this to a PUBLIC IP or a
# DNS NAME (e.g. "k8s.example.com") so you can reach the cluster from anywhere.
# Leave blank to fall back to the control-plane node's primary IPv4.
export K8S_CONTROL_PLANE_ENDPOINT=""
# Extra Subject Alternative Names for the API cert (comma-separated). The node
# IP and the endpoint above are always added automatically. Add any additional
# public IPs / domains you'll use to reach the API server.
# e.g. "k8s.example.com,43.204.212.220"
export K8S_API_CERT_SANS=""

# Address Cilium agents use to reach the API server (kube-proxy-free).
# Leave blank to use the control-plane node's auto-detected primary IPv4
# (in-cluster/private address — recommended).
export K8S_SERVICE_HOST=""
export K8S_SERVICE_PORT="6443"

# ---- Cilium L2 LoadBalancer (replaces MetalLB) -----------------------------
# Pool of IPs Cilium hands out to type=LoadBalancer Services and announces
# over L2 (ARP). MUST be on the same L2 segment as the nodes.
export CILIUM_LB_IP_CIDR="172.17.17.200/29"
# Regex of the network interfaces that announce the LB IPs over L2.
export CILIUM_L2_INTERFACE="^e(n|th).*"
# Announce LB IPs from worker nodes only (true) or all nodes (false).
export CILIUM_L2_WORKERS_ONLY="true"

# ---- Observability ----------------------------------------------------------
export CILIUM_HUBBLE_ENABLED="true"
export CILIUM_HUBBLE_UI_ENABLED="true"

# ---- Local pretty logs ------------------------------------------------------
# Force the neon callback even through wrappers/CI. Unset for plain logs.
export ANSIBLE_FORCE_COLOR="1"
