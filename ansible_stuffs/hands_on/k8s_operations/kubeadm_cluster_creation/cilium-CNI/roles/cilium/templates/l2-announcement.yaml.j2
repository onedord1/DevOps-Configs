# Managed by Ansible — Cilium L2 LoadBalancer configuration
# A pool of IPs handed to type=LoadBalancer Services, announced over L2 (ARP).
apiVersion: "cilium.io/v2alpha1"
kind: CiliumLoadBalancerIPPool
metadata:
  name: default-lb-pool
spec:
  blocks:
    - cidr: "{{ cilium_lb_ip_cidr }}"
---
apiVersion: "cilium.io/v2alpha1"
kind: CiliumL2AnnouncementPolicy
metadata:
  name: default-l2-policy
spec:
  loadBalancerIPs: true
  externalIPs: true
  interfaces:
    - "{{ cilium_l2_interface }}"
  nodeSelector:
    matchExpressions:
{% if cilium_l2_workers_only %}
      # Announce only from worker nodes (keep control-plane out of the data path)
      - key: node-role.kubernetes.io/control-plane
        operator: DoesNotExist
{% else %}
      # Announce from every node
      - key: kubernetes.io/os
        operator: In
        values:
          - linux
{% endif %}
