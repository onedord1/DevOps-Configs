# Managed by Ansible — kubeadm cluster configuration (API v1beta4 / k8s 1.32)
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: "{{ node_ip }}"
  bindPort: {{ api_server_port }}
nodeRegistration:
  name: "{{ control_plane_node_name }}"
  criSocket: "unix://{{ containerd_socket }}"
  kubeletExtraArgs:
    - name: node-ip
      value: "{{ node_ip }}"
# kube-proxy is intentionally NOT installed — Cilium fully replaces it.
skipPhases:
  - addon/kube-proxy
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: "{{ kubeadm_version }}"
# Stable endpoint (public IP or DNS) used by every kubeconfig + cert SAN, so
# the API server is reachable from anywhere this address resolves/routes to.
controlPlaneEndpoint: "{{ control_plane_endpoint }}:{{ api_server_port }}"
apiServer:
  certSANs:
{% for san in api_cert_sans %}
    - "{{ san }}"
{% endfor %}
networking:
  podSubnet: "{{ pod_cidr }}"
  serviceSubnet: "{{ service_cidr }}"
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
